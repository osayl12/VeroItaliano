# Copy this file to .env and change the values. NEVER commit .env to GitHub.
# Edit .env in VS Code (UTF-8). Don't append to it with ">>" in Windows PowerShell 5 (that writes UTF-16).

# Owner login for /admin (created automatically the first time the server starts, min 12 characters)
ADMIN_USERNAME=sharif
ADMIN_PASSWORD=change-me-to-a-strong-password

# Long random string (min 32 characters) - generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# MongoDB Atlas (Database > Connect > Drivers). Keep "/veroitaliano" before the "?".
# Your IP (and the server's IP) must be in Atlas > Network Access.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>.mongodb.net/veroitaliano?retryWrites=true&w=majority&appName=VeroItaliano
PORT=5000

# Number of proxies in front of the API, so the login rate limit sees the real visitor IP.
# 1 = the client nginx only (local Docker). Production (Caddy -> nginx -> API) uses 2.
TRUST_PROXY=1

# Port the website is served on by docker-compose.
# Use 127.0.0.1:8084 to bind only to localhost (behind a reverse proxy such as Caddy).
WEB_PORT=80
