# Copy this file to .env and change the values. NEVER commit .env to GitHub.

# Owner login for /admin (created automatically the first time the server starts)
ADMIN_USERNAME=sharif
ADMIN_PASSWORD=change-me-to-a-strong-password

# Long random string - generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Local development only (docker-compose overrides this)
MONGO_URI=mongodb://localhost:27017/veroitaliano
PORT=5000

# Port the website is served on by docker-compose
WEB_PORT=80
